# Contact form email delivery (https://resend.com).
# If RESEND_API_KEY or CONTACT_TO_EMAIL is missing, submissions are logged
# on the server and the visitor still sees the success message.

# API key from the Resend dashboard.
RESEND_API_KEY=

# Where enquiries are delivered. Comma-separate several addresses.
CONTACT_TO_EMAIL=

# Optional. Sender address; must be on a domain you have verified in Resend,
# e.g. "Cromford website <website@cromford.in>". Defaults to Resend's test sender.
CONTACT_FROM_EMAIL=
